# Copy this file to .env in this folder (the repository root). Never commit .env, and never write a key into it:
# the values below are references that python-dotenv expands from your shell environment.

# =============================================================================
# LANGSMITH
# =============================================================================
# Export LANGSMITH_KEY in your shell; this line passes it on without writing it to disk.
LANGSMITH_API_KEY=${LANGSMITH_KEY}
LANGSMITH_TRACING="true"
# EU-region accounts use this address. Accounts in the US region use https://api.smith.langchain.com instead.
LANGSMITH_ENDPOINT="https://eu.api.smith.langchain.com"
LANGSMITH_PROJECT="compliance-brief"

# =============================================================================
# MODEL
# =============================================================================
# Where the agents' model calls go:
#   claude-code  live calls through headless Claude Code on the signed-in account (no provider key)
#   record       live calls as above, each one also saved to the recordings folder
#   replay       answers served from the recordings folder only; a request with no recording fails by name
#   langchain    the starter's route: init_chat_model(MODEL_NAME) with a provider key of your own
MODEL_BACKEND="replay"

# The folder that record writes to and replay reads from. A relative path is taken from this folder.
MODEL_RECORDINGS_DIR="03_document_summary_agent/recordings"

# Used only when MODEL_BACKEND is langchain, as `provider:model`, with that provider's own key and settings.
MODEL_NAME="openai:gpt-6-luna"
